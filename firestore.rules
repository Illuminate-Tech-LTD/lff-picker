rules_version = '2';

// LFF 2026 shortlist — shared state for a small group, written straight from a
// static page with no sign-in. Anyone with the URL can read and write, so the
// rules are the only guard: they pin access to the two known collections,
// validate the document shape, cap the size, forbid deletes, and stop
// accepting writes once the festival is over.
service cloud.firestore {
  match /databases/{database}/documents {

    // Writes are refused after this instant.
    function stillOpen() {
      return request.time < timestamp.date(2026, 10, 25);
    }

    function validName() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
    }

    function validStamp() {
      return request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
    }

    // Shortlist ticks: { name, picks: [filmId, ...], updatedAt }
    match /shortlists/{person} {
      allow read: if true;
      allow create, update: if stillOpen()
        && validName() && validStamp()
        && request.resource.data.keys().hasOnly(['name', 'picks', 'updatedAt'])
        && request.resource.data.picks is list
        && request.resource.data.picks.size() <= 50;
      allow delete: if false;
    }

    // Locked-in showings: { name, choices: {filmId: screeningIndex}, updatedAt }
    match /lockedScreenings/{person} {
      allow read: if true;
      allow create, update: if stillOpen()
        && validName() && validStamp()
        && request.resource.data.keys().hasOnly(['name', 'choices', 'updatedAt'])
        && request.resource.data.choices is map
        && request.resource.data.choices.keys().size() <= 50;
      allow delete: if false;
    }

    // Nothing else in the database is reachable from the web.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
